<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Forgot Password | Sherill Kay</title><link rel="stylesheet" href="/style.css"></head><body class="loginpage"><div class="login"><p class="eyebrow">ACCOUNT RECOVERY</p><h1>Forgot password?</h1><p class="muted">Enter the admin email address. A 6-digit verification code will be sent to the registered email.</p><% if(error){ %><div class="error"><%= error %></div><% } %><% if(message){ %><div class="notice"><%= message %></div><p><a href="/admin/verify-code">Enter the verification code →</a></p><% } %><form method="post" action="/admin/forgot-password"><label>Admin email<input type="email" name="email" required></label><button class="button" type="submit">Send verification code</button></form><a class="forgot" href="/admin/login">Back to login</a></div></body></html>
