<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Verify Code | Sherill Kay</title><link rel="stylesheet" href="/style.css"></head><body class="loginpage"><div class="login"><p class="eyebrow">EMAIL VERIFICATION</p><h1>Enter your code</h1><p class="muted">Enter the 6-digit code sent to the admin email. It expires after 10 minutes.</p><% if(error){ %><div class="error"><%= error %></div><% } %><form method="post" action="/admin/verify-code"><label>Verification code<input type="text" name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required></label><button class="button" type="submit">Verify code</button></form><a class="forgot" href="/admin/forgot-password">Request another code</a></div></body></html>
