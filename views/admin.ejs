<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Admin Dashboard | Sherill Kay</title>
  <link rel="stylesheet" href="/style.css">
</head>

<body class="adminpage">

<header>
  <div class="top">
    Sherill Kay · Admin Dashboard
    <span><%= adminEmail %></span>
  </div>

  <nav>
    <a class="brand" href="/">
      SHERILL KAY
      <small>GOLDEN RETRIEVER BREEDER</small>
    </a>

    <div class="links">
      <a href="/" target="_blank">View site</a>

      <form method="post" action="/admin/logout" class="inline">
        <button class="logout" type="submit">Log out</button>
      </form>
    </div>
  </nav>
</header>

<main class="dashboard">

  <h1>Admin Dashboard</h1>

  <% if(message){ %>
    <div class="notice"><%= message %></div>
  <% } %>


  <!-- =========================
       ADD PUPPY
  ========================== -->

  <section class="panel">
    <h2>Add a puppy</h2>

    <form
      class="formgrid"
      method="post"
      action="/admin/puppies/add"
      enctype="multipart/form-data"
    >

      <label>
        Name
        <input name="name" required>
      </label>

      <label>
        Gender
        <select name="gender">
          <option>Male</option>
          <option>Female</option>
        </select>
      </label>

      <label>
        Age
        <input name="age" placeholder="10 weeks" required>
      </label>

      <label>
        Price
        <input name="price" placeholder="$1,800" required>
      </label>

      <label>
        Status
        <select name="status">
          <option>Available</option>
          <option>Reserved</option>
          <option>Adopted</option>
        </select>
      </label>

      <label>
        Photo
        <input
          type="file"
          name="image"
          accept="image/jpeg,image/png,image/webp,image/gif"
        >
      </label>

      <label class="wide">
        Description
        <textarea name="description" rows="4"></textarea>
      </label>

      <button class="button" type="submit">
        Add puppy
      </button>

    </form>
  </section>


  <!-- =========================
       MANAGE PUPPIES
  ========================== -->

  <section class="panel">
    <h2>Manage puppies</h2>

    <% puppies.forEach(p=>{ %>

      <div class="adminitem">

        <div class="thumb">
          <% if(p.image){ %>
            <img
              src="<%= p.image.startsWith('http')?p.image:'/uploads/'+p.image %>"
              alt=""
            >
          <% } %>
        </div>

        <form
          class="formgrid compact"
          method="post"
          action="/admin/puppies/<%= p.id %>/edit"
          enctype="multipart/form-data"
        >

          <label>
            Name
            <input name="name" value="<%= p.name %>" required>
          </label>

          <label>
            Gender
            <input name="gender" value="<%= p.gender %>" required>
          </label>

          <label>
            Age
            <input name="age" value="<%= p.age %>" required>
          </label>

          <label>
            Price
            <input name="price" value="<%= p.price %>" required>
          </label>

          <label>
            Status
            <select name="status">
              <option <%= p.status==='Available'?'selected':'' %>>
                Available
              </option>

              <option <%= p.status==='Reserved'?'selected':'' %>>
                Reserved
              </option>

              <option <%= p.status==='Adopted'?'selected':'' %>>
                Adopted
              </option>
            </select>
          </label>

          <label>
            Replace photo
            <input
              type="file"
              name="image"
              accept="image/jpeg,image/png,image/webp,image/gif"
            >
          </label>

          <label class="wide">
            Description
            <textarea name="description" rows="3"><%= p.description %></textarea>
          </label>

          <button class="button" type="submit">
            Save changes
          </button>

        </form>

        <form
          method="post"
          action="/admin/puppies/<%= p.id %>/delete"
          class="delete"
          onsubmit="return confirm('Delete this puppy?')"
        >
          <button type="submit">Delete</button>
        </form>

      </div>

    <% }) %>

  </section>


  <!-- =========================
       HOMEPAGE IMAGES
  ========================== -->

  <section class="panel">
    <h2>Homepage images</h2>

    <div class="image-settings">

      <% images.forEach(im=>{ %>

        <form
          method="post"
          action="/admin/images/<%= im.slot %>"
          enctype="multipart/form-data"
        >

          <h3><%= im.label %></h3>

          <input
            type="file"
            name="image"
            accept="image/jpeg,image/png,image/webp,image/gif"
            required
          >

          <button class="button" type="submit">
            Update image
          </button>

        </form>

      <% }) %>

    </div>
  </section>


  <!-- =========================
       ADOPTION PROCESS
  ========================== -->

  <section class="panel adoption-process-panel">

    <h2>Adoption process</h2>

    <form
      class="process-form"
      method="post"
      action="/admin/process/update"
    >

      <% processSteps.forEach((s,i)=>{ %>

        <div class="process-step">

          <div class="process-field">

            <div class="process-step-number">
              Step <%= s.step_number %>
            </div>

            <label>
              Title
              <input
                type="text"
                name="title<%= i+1 %>"
                value="<%= s.title %>"
                required
              >
            </label>

          </div>


          <div class="process-field">

            <div class="process-step-number">
              Step <%= s.step_number %> description
            </div>

            <label>
              Description
              <textarea
                name="description<%= i+1 %>"
                rows="4"
                required
              ><%= s.description %></textarea>
            </label>

          </div>

        </div>

      <% }) %>


      <div class="process-submit">
        <button class="button" type="submit">
          Save process
        </button>
      </div>

    </form>

  </section>


  <!-- =========================
       PASSWORD RECOVERY
  ========================== -->

  <section class="panel">
    <h2>Password recovery</h2>

    <p>
      Admin recovery email:
      <strong><%= adminEmail %></strong>
    </p>

    <p>
      <a href="/admin/forgot-password">
        Test forgot-password flow →
      </a>
    </p>
  </section>

</main>

</body>
</html>
